[Unit]
Description=Repo Scout read-only pilot tick
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=repo-scout-pilot
WorkingDirectory=/opt/repo-scout
Environment=PYTHONUTF8=1
EnvironmentFile=-/etc/repo-scout-pilot.env
ExecStart=/opt/repo-scout/.venv/bin/python -m repo_scout.pilot --home /var/lib/repo-scout-pilot tick
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
